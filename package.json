{
  "name": "angelinas-emergency",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Angelina's Emergency \u2014 a 2D top-down stealth game for browser (desktop + iOS).",
  "scripts": {
    "dev": "vite --host",
    "build": "tsc --noEmit -p tsconfig.json && vite build",
    "preview": "vite preview --host",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src",
    "gen:icons": "node scripts/gen-icons.mjs",
    "gen:tiles": "node scripts/gen-placeholder-tileset.mjs",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "phaser": "4.2.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.62.1",
    "@types/node": "^24.0.0",
    "@types/pngjs": "^6.0.5",
    "eruda": "^3.4.3",
    "eslint": "^10.8.1",
    "pngjs": "^7.0.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.67.0",
    "vite": "^7.3.6",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^4.1.10"
  },
  "engines": {
    "node": ">=20"
  }
}
